import socket
import json
import time
import math
import random

# Target Ground Control Station UDP Endpoint
GCS_IP = "127.0.0.1"
GCS_PORT = 14550

sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

print("="*60)
print("  🚀 AEROTWIN PHYSICAL UAV TELEMETRY TRANSMITTER (ONBOARD SIM)")
print(f"  Target GCS Node: udp://{GCS_IP}:{GCS_PORT}")
print("  Streaming 50Hz FADEC telemetry frames over network link...")
print("="*60)

met = 0
altitude = 1200.0
rpm = 5000.0
cht = 112.0
oil_p = 4.2

try:
    while True:
        met += 1
        
        # Flight regime dynamics
        if met < 40:
            phase = "CLIMB"
            altitude += 25
            rpm = 5300 + random.uniform(-20, 20)
        elif met < 150:
            phase = "CRUISE"
            rpm = 4950 + random.uniform(-15, 15)
        else:
            phase = "DESCENT"
            altitude = max(200, altitude - 15)
            rpm = 4400 + random.uniform(-25, 25)

        # Physics Model baseline
        cht_model = 110.0 + (rpm - 4800) * 0.02
        oil_model = 4.2 - (rpm - 4800) * 0.0003

        # Fault Injection after T+60s (Simulating real thermal runaway)
        if met > 60:
            cht += random.uniform(0.3, 0.7)  # Overheating
            oil_p = max(1.1, oil_p - random.uniform(0.01, 0.03))
            vibe = 1.2 + random.uniform(0.4, 0.9)
        else:
            cht = cht_model + random.uniform(-0.5, 0.5)
            oil_p = oil_model + random.uniform(-0.05, 0.05)
            vibe = 1.05 + random.uniform(-0.05, 0.05)

        # Standard STANAG / MAVLink Payload Schema
        payload = {
            "timestamp": met,
            "rpm": round(rpm, 1),
            "cht_actual": round(cht, 2),
            "cht_physics": round(cht_model, 2),
            "oil_press_actual": round(oil_p, 2),
            "oil_press_physics": round(oil_model, 2),
            "egt_actual": round(810.0 + random.uniform(-4, 4), 1),
            "egt_physics": 810.0,
            "map_inhg": round(32.5 + random.uniform(-0.3, 0.3), 2),
            "vibration_rms": round(vibe, 2),
            "altitude_m": round(altitude, 1),
            "fuel_flow": round(24.5 + (rpm - 4800) * 0.008, 2),
            "flight_phase": phase
        }

        packet_bytes = json.dumps(payload).encode('utf-8')
        sock.sendto(packet_bytes, (GCS_IP, GCS_PORT))

        status_flag = "⚠️ FAULT ACTIVE" if met > 60 else "✓ NOMINAL"
        print(f"[MET: T+{met:03d}s] {phase} | RPM: {rpm:.0f} | CHT: {cht:.1f}°C | Oil: {oil_p:.2f}bar | {status_flag}")
        time.sleep(0.5)  # 2 Hz telemetry rate

except KeyboardInterrupt:
    print("\n🛑 Telemetry uplink terminated by ground operator.")
    sock.close()
